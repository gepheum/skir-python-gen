/// Day of the week
enum Weekday {
  MONDAY;
  TUESDAY;
  WEDNESDAY;
  THURSDAY;
  FRIDAY;
  SATURDAY;
  /// Fun day
  SUNDAY;
}

enum JsonValue {
  NULL = 1;
  /// A boolean value
  boolean: bool = 100;
  number: float64 = 6;
  string: string = 3;
  array: [JsonValue] = 4;
  struct Pair {
    name: string = 0;
    value: JsonValue = 1;
  }
  object: [Pair|name] = 5;
}

enum EmptyEnum {}

enum EnumWithNameConflict {
  SERIALIZER;
}

enum EnumWithStructField {
  /// The S struct
  struct S {
    /// x coordinate
    x: float32 = 0;
    /// y coordinate
    y: float32 = 1;
  }
  s: S = 1;
}
